<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Platform-NEUTRAL. CA1416 makes any Windows-only API call here a build error,
         which is what keeps this layer testable from macOS. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VoxScribe.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxScribe.Abstractions\VoxScribe.Abstractions.csproj" />
    <ProjectReference Include="..\VoxScribe.Dictionary\VoxScribe.Dictionary.csproj" />
    <!-- DPAPI for the API keys in settings.json. Windows-only at runtime; every call is
         behind OperatingSystem.IsWindows(), which is what satisfies CA1416 and keeps the
         project buildable and testable on macOS. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
